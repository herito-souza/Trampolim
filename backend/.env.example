# Ative o perfil de produção e substitua todos os valores de exemplo no gerenciador de segredos do ambiente.
SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=jdbc:postgresql://db.seu-dominio.com:5432/trampolim_db
DATABASE_USERNAME=trampolim
DATABASE_PASSWORD=troque-por-um-segredo
OPORTUNIDADES_DB_URL=jdbc:postgresql://db.seu-dominio.com:5432/trampolim_db
OPORTUNIDADES_DB_USERNAME=${DATABASE_USERNAME}
OPORTUNIDADES_DB_PASSWORD=${DATABASE_PASSWORD}
# Bases independentes implementadas para Empresas e Capacita. Na configuração local,
# docker-compose.yml publica essas bases nas portas 5433 e 5434.
EMPRESAS_DB_NAME=trampolim_empresas_db
EMPRESAS_DB_ENABLED=true
EMPRESAS_DB_URL=jdbc:postgresql://localhost:5433/trampolim_empresas_db
EMPRESAS_DB_USERNAME=trampolim_empresas
EMPRESAS_DB_PASSWORD=troque-por-um-segredo
CAPACITA_DB_NAME=trampolim_capacita_db
CAPACITA_DB_ENABLED=true
CAPACITA_DB_URL=jdbc:postgresql://localhost:5434/trampolim_capacita_db
CAPACITA_DB_USERNAME=trampolim_capacita
CAPACITA_DB_PASSWORD=troque-por-um-segredo
JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-bytes
EMPRESAS_JWT_SECRET=gere-um-segredo-aleatorio-exclusivo-com-pelo-menos-32-bytes
CAPACITA_JWT_SECRET=gere-outro-segredo-aleatorio-exclusivo-com-pelo-menos-32-bytes
LEGACY_COMPANY_AUTH_ENABLED=false
LEGACY_ORGANIZATIONS_ENABLED=false
FRONTEND_URL=https://www.seu-dominio.com
CORS_ALLOWED_ORIGINS=https://www.seu-dominio.com
ADMIN_EMAILS=admin@seu-dominio.com
MAIL_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PUBLIC_API_URL=https://api.seu-dominio.com
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_USERNAME=usuario-smtp
SMTP_PASSWORD=senha-smtp
LEGACY_OPORTUNIDADES_TOKENS_ENABLED=false

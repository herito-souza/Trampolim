# Ative o perfil de produção e substitua todos os valores de exemplo no gerenciador de segredos do ambiente.
SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=jdbc:postgresql://db.seu-dominio.com:5432/trampolim_db
DATABASE_USERNAME=trampolim
DATABASE_PASSWORD=troque-por-um-segredo
OPORTUNIDADES_DB_URL=jdbc:postgresql://db.seu-dominio.com:5432/trampolim_db
OPORTUNIDADES_DB_USERNAME=${DATABASE_USERNAME}
OPORTUNIDADES_DB_PASSWORD=${DATABASE_PASSWORD}
# Bases independentes implementadas para Empresas e Capacita. Na configuração local,
# docker-compose.yml publica essas bases nas portas 5433 e 5434.
EMPRESAS_DB_NAME=trampolim_empresas_db
EMPRESAS_DB_ENABLED=true
EMPRESAS_DB_URL=jdbc:postgresql://localhost:5433/trampolim_empresas_db
EMPRESAS_DB_USERNAME=trampolim_empresas
EMPRESAS_DB_PASSWORD=troque-por-um-segredo
CAPACITA_DB_NAME=trampolim_capacita_db
CAPACITA_DB_ENABLED=true
CAPACITA_DB_URL=jdbc:postgresql://localhost:5434/trampolim_capacita_db
CAPACITA_DB_USERNAME=trampolim_capacita
CAPACITA_DB_PASSWORD=troque-por-um-segredo
# Contas existentes e verificadas do Capacita para a administração educacional inicial.
CAPACITA_ADMIN_EMAILS=
# Diretório privado persistente, fora da pasta pública do frontend.
CAPACITA_MEDIA_ROOT=storage/capacita/videos
CAPACITA_FFMPEG=ffmpeg
CAPACITA_FFPROBE=ffprobe
# Mural privado: limites independentes das videoaulas de 3 a 5 minutos.
CAPACITA_QUESTION_MEDIA_MAX_BYTES=26214400
CAPACITA_QUESTION_AUDIO_MAX_SECONDS=120
CAPACITA_QUESTION_VIDEO_MAX_SECONDS=120
CAPACITA_QUESTION_MEDIA_QUOTA_BYTES=268435456
CAPACITA_QUESTION_UPLOADS_HOUR=12
# 0 preserva atendimentos encerrados até exclusão explícita; defina prazo após a decisão de retenção.
CAPACITA_QUESTION_CLOSED_RETENTION_DAYS=0
# Biblioteca: PDF privado, versões e processamento em JVM com heap limitado.
CAPACITA_LIBRARY_MAX_BYTES=20971520
CAPACITA_LIBRARY_MAX_PAGES=300
CAPACITA_LIBRARY_QUOTA_BYTES=536870912
CAPACITA_LIBRARY_PROCESSING_SECONDS=45
CAPACITA_LIBRARY_DELETED_RETENTION_DAYS=30
# Retenção operacional dos pedidos de apoio encerrados; 0 desativa a limpeza automática.
CAPACITA_SUPPORT_CLOSED_RETENTION_DAYS=90
JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-bytes
EMPRESAS_JWT_SECRET=gere-um-segredo-aleatorio-exclusivo-com-pelo-menos-32-bytes
CAPACITA_JWT_SECRET=gere-outro-segredo-aleatorio-exclusivo-com-pelo-menos-32-bytes
LEGACY_COMPANY_AUTH_ENABLED=false
LEGACY_ORGANIZATIONS_ENABLED=false
FRONTEND_URL=https://www.seu-dominio.com
CORS_ALLOWED_ORIGINS=https://www.seu-dominio.com
ADMIN_EMAILS=admin@seu-dominio.com
MAIL_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PUBLIC_API_URL=https://api.seu-dominio.com
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_USERNAME=usuario-smtp
SMTP_PASSWORD=senha-smtp
LEGACY_OPORTUNIDADES_TOKENS_ENABLED=false
# Every replica shares three JWT secrets per trail, but never shares one secret across trails.
OPORTUNIDADES_DB_POOL_MAX=10
OPORTUNIDADES_DB_POOL_MIN=1
EMPRESAS_DB_POOL_MAX=10
EMPRESAS_DB_POOL_MIN=1
CAPACITA_DB_POOL_MAX=10
CAPACITA_DB_POOL_MIN=1
DB_CONNECTION_TIMEOUT_MS=5000
HTTP_THREADS_MAX=200
HTTP_ACCEPT_COUNT=100
HTTP_MAX_CONNECTIONS=8192
MANAGEMENT_PORT=9001
MANAGEMENT_ADDRESS=127.0.0.1
MONITORING_KEY=
# Enable on exactly one designated instance; reads may be replicated separately.
CATALOG_JOBS_ENABLED=true

# Exact browser origins; use the public HTTPS URL in production.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server-to-server contracts only, never browser credentials. Required for verified imports.
RADAR_INTERNAL_API_URL=http://127.0.0.1:8080/api
RADAR_BRIDGE_SECRET=

# Internal notifications and preparation refresh for future hiring forecasts.
FUTURE_TALENT_POLL_ENABLED=true
FUTURE_TALENT_POLL_DELAY_MS=60000

HUB_LOGO_DIRECTORY=storage/hub-logos

# Durable invalidation of consented Radar evidence (no credentials in browser)
PASSPORT_DELIVERY_ENABLED=true
PASSPORT_DELIVERY_DELAY_MS=30000

# Priority 5: no external AI calls until enabled; configure OPENAI_API_KEY separately.
MENTOR_AI_ENABLED=false
MENTOR_USER_DAILY_CALLS=20
MENTOR_GLOBAL_DAILY_CALLS=1000
MENTOR_USER_DAILY_TOKENS=40000
MENTOR_GLOBAL_DAILY_TOKENS=1000000
MENTOR_MAX_OUTPUT_TOKENS=600
MENTOR_INPUT_USD_PER_MILLION=
MENTOR_OUTPUT_USD_PER_MILLION=
CAREER_DELIVERY_ENABLED=true
OBSERVATORY_CAPTURE_ENABLED=true

# Optional overrides (trusted server configuration only)
MENTOR_BASE_URL=https://api.openai.com
CAREER_DELIVERY_DELAY_MS=30000
OBSERVATORY_CAPTURE_DELAY_MS=3600000

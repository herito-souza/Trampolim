DATABASE_NETWORK=backend_default
# Copy to .env.local; local demonstration only. Never commit actual secrets.
OPORTUNIDADES_DB_URL=jdbc:postgresql://postgres:5432/trampolim_db
OPORTUNIDADES_DB_USERNAME=root
OPORTUNIDADES_DB_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
EMPRESAS_DB_URL=jdbc:postgresql://postgres-empresas:5432/trampolim_empresas_db
EMPRESAS_DB_USERNAME=trampolim_empresas
EMPRESAS_DB_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
CAPACITA_DB_URL=jdbc:postgresql://postgres-capacita:5432/trampolim_capacita_db
CAPACITA_DB_USERNAME=trampolim_capacita
CAPACITA_DB_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_OPORTUNIDADES_SECRET_AT_LEAST_32_CHARACTERS
EMPRESAS_JWT_SECRET=REPLACE_WITH_EMPRESAS_SECRET_AT_LEAST_32_CHARACTERS
CAPACITA_JWT_SECRET=REPLACE_WITH_CAPACITA_SECRET_AT_LEAST_32_CHARACTERS
MONITORING_KEY=REPLACE_WITH_MONITORING_SECRET_AT_LEAST_32_CHARACTERS
OPORTUNIDADES_DB_POOL_MAX=10
EMPRESAS_DB_POOL_MAX=10
CAPACITA_DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
FRONTEND_URL=http://localhost:8088
# Activate SMTP and provider credentials deliberately before use outside development.
MAIL_ENABLED=false
CAPACITA_FFPROBE=ffprobe
CAPACITA_FFMPEG=ffmpeg

APP_CORS_ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088
